# Password-gated admin views at /workshops/telegrambot/admin and /workshops/ai-automation/admin.
ADMIN_DASHBOARD_PASSWORD=
# Random secret used to sign the admin session cookie (e.g. `openssl rand -hex 32`).
ADMIN_SESSION_SECRET=

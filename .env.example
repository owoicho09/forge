# ==========================================
# SUPABASE (ForgeBuilds CRM project — separate from Search4Jobs)
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser / NEXT_PUBLIC_ vars.
SUPABASE_SERVICE_ROLE_KEY=

# ==========================================
# WORKSHOPS (/workshops/telegrambot, /workshops/ai-automation)
# ==========================================
# WhatsApp community invite link shown after a successful registration (shared by all workshops).
